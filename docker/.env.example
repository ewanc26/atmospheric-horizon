# Copy to docker/.env and replace these values before starting the server.
# The admin token authorizes operator routes. The link token is shared with the
# game server's config.json and is never sent to a player's browser.
ATMOSPHERIC_SERVER_TOKEN=replace-with-a-long-random-admin-token
ATMOSPHERIC_SERVER_LINK_TOKEN=replace-with-a-long-random-link-token

# Public HTTPS origin for this service. It must route /link, /skin and
# /oauth-client-metadata.json to the container and terminate TLS.
ATMOSPHERIC_SERVER_PUBLIC_URL=https://links.example.com

# Optional: the server account's did:plc (or did:web) to sign labels as.
# Leave empty to disable the labeler. When set, keep /data/labeler private.
ATMOSPHERIC_SERVER_LABELER_DID=

# Optional: path inside the container to the game worker's signing-key.json.
# Copy that file into the data volume first (for example to
# /data/skin-signing-key.json) and set this to the same path. Leave empty to
# disable browser skin upload.
ATMOSPHERIC_SERVER_SKIN_KEY=

# Optional and experimental (#189): DID-authenticated admin grants. The static
# ATMOSPHERIC_SERVER_TOKEN above stays valid on every admin route; these only
# add a second, short-lived scoped credential. Keep /data private: when the
# feature is on it holds an owner-only audit key and receipts under
# /data/operator. All four routes are on this service's /v1 surface.
# Comma-separated did:plc/did:web allowlist. Leave unset or empty (default) to
# disable the feature entirely; no audit key or log is then created.
# ATMOSPHERIC_SERVER_OPERATOR_DIDS=did:plc:...,did:web:example.com
# Grant lifetime in seconds (default 900, max 3600); too long fails startup.
# ATMOSPHERIC_SERVER_OPERATOR_GRANT_TTL_SECONDS=900
# Comma-separated subset of links_read, links_write, pairing_create,
# label_emit, audit_read. Unset grants all five.
# ATMOSPHERIC_SERVER_OPERATOR_SCOPES=links_read,links_write,pairing_create,label_emit,audit_read
# Resolver overrides for the Proof-of-Handle check (#185/#189).
# ATMOSPHERIC_SERVER_OPERATOR_HANDLE_SERVICE=https://bsky.social
# ATMOSPHERIC_SERVER_OPERATOR_PLC_DIRECTORY=https://plc.directory
