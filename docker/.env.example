# Copy to docker/.env and replace these values before starting the server.
# The admin token authorizes operator routes. The link token is shared with the
# game server's config.json and is never sent to a player's browser.
ATMOSPHERIC_SERVER_TOKEN=replace-with-a-long-random-admin-token
ATMOSPHERIC_SERVER_LINK_TOKEN=replace-with-a-long-random-link-token

# Public HTTPS origin for this service. It must route /link and
# /oauth-client-metadata.json to the container and terminate TLS.
ATMOSPHERIC_SERVER_PUBLIC_URL=https://links.example.com

# Optional: the server account's did:plc (or did:web) to sign labels as.
# Leave empty to disable the labeler. When set, keep /data/labeler private.
ATMOSPHERIC_SERVER_LABELER_DID=
